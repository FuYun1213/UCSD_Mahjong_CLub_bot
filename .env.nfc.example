# Local demonstration only. Set false and replace get_current_user for production.
NFC_MOCK_AUTH_ENABLED=true
NFC_YOLO_API_KEY=local-demo-yolo-key
NFC_DATABASE_PATH=data/nfc_matches.sqlite3
NFC_INITIAL_POINTS=25000
NFC_LOGIN_URL=/login
NFC_FRONTEND_SIT_PATH=/sit
# e.g. https://example.com (no wildcard when sending cookies)
NFC_ALLOWED_ORIGINS=http://localhost:5000,http://localhost:8000

# Set true after configuring your own spreadsheet and service account.
NFC_SHEETS_ENABLED=false
NFC_SPREADSHEET_ID=
NFC_GOOGLE_CREDENTIALS=credentials.json
NFC_CURRENT_SHEET=当前对局表
NFC_HISTORY_SHEET=历史对局记录表
NFC_SYNC_INTERVAL_SECONDS=10
NFC_GOOGLE_TIMEOUT_SECONDS=15

# SQLAlchemy: blank uses NFC_DATABASE_PATH; PostgreSQL requires requirements-api-postgres.txt.
NFC_DATABASE_URL=
# Example: postgresql+psycopg://user:password@127.0.0.1/mahjong
# Install requirements-api-vision.txt for the tested blue LCD / red LED decoder.
# Optional custom-region neural OCR: requirements-api-yolo.txt + scripts/install_nfc_vision.py.
NFC_VISION_ENABLED=true
NFC_VISION_DIRECTORY=third_party/lcd_digit_recognition
NFC_VISION_CONFIDENCE=0.95

# Existing website account bridge (enable after deploying the profile ID change):
NFC_AUTH_PROFILE_URL=
# NFC_AUTH_PROFILE_URL=http://127.0.0.1:5000/api/session

# Website forwards only the score/seating routes to this local API.
NFC_API_URL=http://127.0.0.1:8001

# Set to the existing club database to publish photo matches into its rankings.
# Production: /app/mahjong.sqlite3. Blank keeps a standalone NFC installation.
NFC_CLUB_DATABASE_PATH=
NFC_REPLACE_RECORDING=true

# Tournament mode uses the existing NFC database; migrations only add tables.
# Club player directory is read-only. Defaults to the website's mahjong.sqlite3.
TOURNAMENT_CLUB_DATABASE_PATH=
# Public origin used in downloadable QR codes behind a reverse proxy (no trailing slash).
PUBLIC_SITE_URL=
# Only on the server. Enter/enable the endpoint under Admin > External API.
# Existing deployments may explicitly supply this as the initial default:
NARTS_EXTERNAL_API_ENDPOINT=
NARTS_EXTERNAL_API_KEY=
# Optional bearer token for the Generic JSON adapter:
EXTERNAL_API_KEY=

# Optional private server file; takes precedence over NARTS_EXTERNAL_API_KEY.
NARTS_EXTERNAL_API_KEY_FILE=

# Trust only the exact reverse-proxy peer; do not expose the app port publicly.
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128

# Server-only reservation-session Discord reminders. Missing configuration never
# prevents a reservation. The API independently checks persistent jobs every 15s.
DISCORD_RESERVATION_REMINDERS_ENABLED=true
# Reuse DISCORD_BOT_TOKEN from the server environment or DISCORD_BOT_TOKEN.env.
# Never place a token in browser code or a tracked file.
DISCORD_GUILD_ID=1278056421224747162
DISCORD_RESERVATION_REMINDER_CHANNEL_ID=
# An explicitly set DISCORD_GAME_RECORD_CHANNEL_ID is the legacy fallback.
# Bot needs View Channel, Send Messages and Read Message History for reconciliation.

# Optional website Discord OAuth. Register this exact callback in the Discord application.
# Registration and normal login remain available without these values.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=
